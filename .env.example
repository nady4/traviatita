# token del bot de Discord (obligatorio)
TOKEN=tu_token_aqui

# servidor donde se registran los comandos (actualización instantánea)
# si no se define, se registran globalmente y pueden tardar hasta 1 hora en propagarse
GUILD_ID=

# carpeta persistente para todos los JSON de estado (días, hormonas, stock, quilombo)
# si no se setea, se guardan junto al código; en hosting con redeploy apuntala a un volumen
STATE_DIR=

# roles para /travestir y la asignación automática a nuevos miembros
ROLE_TRAVIATENSE_ID=
ROLE_BOT_ID=
ROLE_200KG_ID=

# roles que se pinguean en cada aviso de stock
ROLE_OTOKONOKO_ID=1564743557733027871
ROLE_ASTROVIALS_ID=1564743677601915051

# canales de anuncios
CHANNEL_ANNOUNCE_QUILOMBO_ID=
CHANNEL_ANNOUNCE_STOCK_ID=

# intervalo de chequeo de stock (minutos), compartido por otokonoko y astrovials
STOCK_CHECK_MINUTES=10
