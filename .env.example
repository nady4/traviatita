TOKEN=tu_token_aqui

# carpeta persistente para todos los JSON de estado (días, hormonas, stock, quilombo)
# si no se setea, se guardan junto al código; en hosting con redeploy apuntala a un volumen
STATE_DIR=

QUILOMBO_ANNOUNCE_CHANNEL_ID=1527109090965192774

# roles para /travestir y la asignación automática a nuevos miembros
ROL_TRAVIATENSE=1570037127620853843
ROL_BOT=1527109023684624475
ROL_200KG=1527108970857234595

# intervalo de chequeo de stock (minutos), compartido por otokonoko y astrovials
CHECK_MINUTES=10
OTK_ANNOUNCE_CHANNEL_ID=id_del_canal_para_anuncios_de_stock
OTK_NOTIFY_ROLE_ID=1564743557733027871
# si el estado cargado está vencido más que esto (minutos), los cambios se
# reconcilian sin anunciar (anti anuncios fantasma tras reinicio/restore); 0 desactiva
OTK_STALE_ANNOUNCE_MIN=30

ASTRO_ANNOUNCE_CHANNEL_ID=id_del_canal_para_anuncios_astrovials
ASTRO_NOTIFY_ROLE_ID=1564743677601915051
ASTRO_STALE_ANNOUNCE_MIN=30
