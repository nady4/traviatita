# token del bot de Discord (obligatorio)
TOKEN=

# servidor donde se registran los comandos (opcional)
# si no se define, se registran globalmente y pueden tardar hasta 1 hora en propagarse
GUILD_ID=

# carpeta persistente para todos los JSON de estado (opcional)
# si no se setea, se guardan junto al código
STATE_DIR=

