# token del bot de Discord (obligatorio)
TOKEN=

# servidor donde se registran los comandos (opcional)
# si no se define, se registran globalmente y pueden tardar hasta 1 hora en propagarse
GUILD_ID=

# carpeta persistente para los JSON de estado (opcional; no afecta a data/autoroles.json)
# si no se setea, se guardan en data/
STATE_DIR=

# usuario que recibe por DM el link para twittear con /traviatweet
TWEET_USER_ID=

# intervalo de chequeo de publicaciones en x.com (minutos), solo con mensajes pendientes
TWEET_CHECK_MINUTES=5

# intervalo de chequeo de stock (minutos), compartido por otokonoko y astrovials
STOCK_CHECK_MINUTES=1

# zona horaria (IANA) para los resúmenes diario, semanal y mensual de viales ingresados
# si no se define, se usa America/Argentina/Buenos_Aires
STOCK_SUMMARY_TZ=America/Argentina/Buenos_Aires
