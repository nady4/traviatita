# intervalo de chequeo de publicaciones en x.com (minutos), solo con mensajes pendientes
TWEET_CHECK_MINUTES=5

# intervalo de chequeo de stock (minutos), compartido por otokonoko y astrovials
STOCK_CHECK_MINUTES=1

# zona horaria (IANA) para los resúmenes diario, semanal y mensual de viales ingresados
# si no se define, se usa America/Argentina/Buenos_Aires
STOCK_SUMMARY_TZ=America/Argentina/Buenos_Aires
